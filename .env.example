# URL base del backend Laravel (con el prefijo /api incluido).
# Solo define el DEFAULT la primera vez que se abre la app en un navegador;
# después cada usuario puede cambiarla desde el ícono ⚙ (se guarda en localStorage).
VITE_API_BASE_URL=http://localhost:8080/api

# Modo inicial de la app: 'demo' (datos simulados en localStorage)
# o 'live' (contra el backend real). Default si se omite: demo.
VITE_DEFAULT_MODE=demo
